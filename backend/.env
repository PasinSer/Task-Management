# Environment
NODE_ENV = "development"

# MongoDB connection string (replace placeholders with actual values)

DB_CONNECTION_STRING = mongodb://localhost:27017/task-management

# Secret key for JWT or any other authentication tokens
JWT_SECRET = your_jwt_secret_key

# Mongo db password
DB_PASSWORD = ""

# Server port (for development)
PORT = 3000 

# JWT expiry days
JWT_EXPIRES_IN = 90d

# Cookie expiry days
COOKIE_EXPIRES_IN = 90
